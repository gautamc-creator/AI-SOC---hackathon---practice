# Required only to seed a live Elastic deployment.
ELASTIC_URL=https://your-deployment.es.region.aws.elastic.cloud
KIBANA_URL=https://your-deployment.kb.region.aws.elastic.cloud
ELASTIC_API_KEY=replace-me

# --- AWS Bedrock (optional; the demo runs without it) -----------------------
# VIGIL uses Amazon Nova, not Anthropic. For Mumbai use the APAC cross-region
# profile below. The client can discover another available Nova profile when this
# is left empty, provided the IAM identity has the two List permissions.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0
BEDROCK_MAX_OUTPUT_TOKENS=600

# --- Sarvam AI (optional; the demo runs without it) -------------------------
# Free key from https://dashboard.sarvam.ai. With no key VIGIL writes a NOT_RUN
# record rather than emitting placeholder regional text.
SARVAM_API_KEY=
